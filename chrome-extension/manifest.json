{
  "name": "NeuralMail AI - Smart Email Assistant",
  "description": "Multimodal AI email assistant: Ghostwriter autocomplete, smart calendar RSVP, thread executive brief, intent auto-reply, subtext & psych radar, personal persona, and zero-knowledge privacy.",
  "version": "4.0.0",
  "manifest_version": 3,
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "http://localhost:8080/*",
    "http://localhost:8081/*",
    "http://localhost:8082/*",
    "https://*.onrender.com/*",
    "*://mail.google.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["*://mail.google.com/*"],
    "js": ["content.js"],
    "run_at": "document_end"
  }],
  "web_accessible_resources": [{
    "resources": ["icons/*"],
    "matches": ["*://mail.google.com/*"]
  }],
  "action": {
    "default_popup": "popup.html",
    "default_title": "NeuralMail AI",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}